# 複製這個檔案成 .env 後填入真正的值。.env 不會進 git。

# ── 網站 ──
# 爬蟲起點與唯一允許的網域
SITE_URL=https://www.sinchih.com.tw
# 爬蟲限速：每秒最多幾頁
CRAWL_RATE_PER_SEC=1

# ── Google Search Console ──
# Search Console 裡的資源名稱（網域資源用 sc-domain:sinchih.com.tw）
GSC_SITE_URL=sc-domain:sinchih.com.tw
# 服務帳戶 JSON 金鑰路徑（放在 credentials/ 底下）
GSC_CREDENTIALS_FILE=credentials/service-account.json

# ── 資料庫 ──
DB_PATH=seo_radar.db

# ── 週報寄信（Gmail SMTP + 應用程式密碼）──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
# 收件人，多個用逗號分隔
REPORT_TO=you@gmail.com
